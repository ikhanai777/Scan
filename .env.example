# Copy to .env and edit:  cp .env.example .env
#
# Every value here has a working default. The app runs with no API keys at all:
# price, funding, open interest and the order book come from the exchange, and
# TVL, Fear & Greed and the news feeds are public and keyless. Keys only buy
# extra sources.
#
# Start with:  cryptosignal doctor

# ---- exchange -------------------------------------------------------------
# Binance answers HTTP 451 from several jurisdictions. If doctor reports that,
# switch to one that serves you: kraken, coinbase, kucoin, bybit, okx, gateio.
# Kraken and Coinbase quote in USD, not USDT -- set CS_QUOTE to match.
CS_EXCHANGE=binance
CS_QUOTE=USDT
CS_TIMEFRAME=15m
CS_OHLCV_LIMIT=300

# ---- universe / screening -------------------------------------------------
# A smaller venue than Binance needs a lower volume floor, or nothing passes.
CS_UNIVERSE_SIZE=20
CS_MIN_VOLUME_24H=25000000
CS_MAX_SPREAD_BPS=8
CS_SHORTLIST_SIZE=10

# ---- which legs run -------------------------------------------------------
# Both are on. Turning one off makes fusion renormalise over the rest, so the
# app stays correct -- it just has less evidence.
CS_ENABLE_FUNDAMENTAL=true
CS_ENABLE_SENTIMENT=true

# ---- news / sentiment -----------------------------------------------------
# Comma-separated RSS URLs. Leave blank for the built-in list; doctor reports
# which feeds actually answered from your machine.
CS_NEWS_FEEDS=
CS_NEWS_WINDOW_H=48
CS_NEWS_HALF_LIFE_H=8
# Optional. Free tier at https://cryptopanic.com/developers/api/
CS_CRYPTOPANIC_TOKEN=

# ---- signal thresholds ----------------------------------------------------
CS_LONG_THRESHOLD=60
CS_SHORT_THRESHOLD=-60
CS_MAX_OPEN_SIGNALS=8
CS_SCAN_INTERVAL_S=120

# ---- execution (phase 5) --------------------------------------------------
# disabled | paper | live.  Default is disabled: signals only, no orders.
#
#   paper  records orders against real prices and sends nothing anywhere.
#   live   places REAL orders with REAL money.
#
# Live additionally requires CS_LIVE_CONFIRM to be set to exactly the phrase
# below, and API keys with trade permission. Two independent switches, because
# one environment variable is too easy to set by accident in a deploy config.
CS_EXECUTION_MODE=disabled
# CS_LIVE_CONFIRM=I understand this places real orders
CS_EXCHANGE_API_KEY=
CS_EXCHANGE_API_SECRET=

# Paper-mode starting equity, and the risk limits that bound every order.
CS_PAPER_EQUITY=10000
CS_RISK_PER_TRADE_PCT=0.5
CS_MAX_ORDER_NOTIONAL=250
CS_MAX_OPEN_POSITIONS=3
CS_MAX_ORDERS_PER_DAY=10
CS_MAX_DAILY_LOSS=100
CS_MIN_EXEC_CONFIDENCE=70
CS_EXECUTE_REDUCED_CONFIDENCE=false

# ---- delivery -------------------------------------------------------------
CS_DB_PATH=cryptosignal.db
CS_API_HOST=127.0.0.1
CS_API_PORT=8000

# Telegram: create a bot with @BotFather, message it once, then read your chat
# id from https://api.telegram.org/bot<token>/getUpdates
CS_TELEGRAM_BOT_TOKEN=
CS_TELEGRAM_CHAT_ID=

# Any endpoint that accepts a JSON POST.
CS_WEBHOOK_URL=

# Log alerts instead of sending them. Useful for a first run.
CS_DRY_RUN=false
