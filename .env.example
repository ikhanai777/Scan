# Copy to .env and edit. Every value here has a working default except the
# alert credentials -- the scanner runs without them, it just stays quiet.

# ---- exchange -------------------------------------------------------------
CS_EXCHANGE=binance
CS_QUOTE=USDT
CS_TIMEFRAME=15m
CS_OHLCV_LIMIT=300

# ---- universe / screening -------------------------------------------------
# Phase 1 default is a top-20 universe. The spec's target is 200-300; raise it
# once you have the rate budget and the on-chain leg to justify the fetches.
CS_UNIVERSE_SIZE=20
CS_MIN_VOLUME_24H=25000000
CS_MAX_SPREAD_BPS=8
CS_SHORTLIST_SIZE=10

# ---- signal thresholds ----------------------------------------------------
CS_LONG_THRESHOLD=60
CS_SHORT_THRESHOLD=-60
CS_MAX_OPEN_SIGNALS=8
CS_SCAN_INTERVAL_S=120

# ---- delivery -------------------------------------------------------------
CS_DB_PATH=cryptosignal.db
CS_API_HOST=127.0.0.1
CS_API_PORT=8000

# Telegram: create a bot with @BotFather, message it once, then read your chat
# id from https://api.telegram.org/bot<token>/getUpdates
CS_TELEGRAM_BOT_TOKEN=
CS_TELEGRAM_CHAT_ID=

# Any endpoint that accepts a JSON POST.
CS_WEBHOOK_URL=

# Log alerts instead of sending them. Useful for a first run.
CS_DRY_RUN=false
